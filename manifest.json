{
  "manifest_version": 3,
  "name": "My Epitech Enhancer",
  "version": "1.0.0",
  "description": "Améliorations d'interface pour My Epitech : pagination, colonnes, filtres de projets et badges des modules.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://my.epitech.eu/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "My Epitech Enhancer"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.epitech.eu/*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://my.epitech.eu/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
